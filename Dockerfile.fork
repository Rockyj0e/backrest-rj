# Self-contained build of this fork: webui -> Go binary -> alpine runtime.
# Mirrors Dockerfile.alpine (runtime), but builds from source instead of
# expecting goreleaser-staged binaries.
#
#   docker build -f Dockerfile.fork -t backrest-rj:dev .

# Stage 1: web UI
FROM node:22-alpine AS webui
RUN npm install -g pnpm@10
WORKDIR /src/webui
COPY webui/package.json webui/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY webui/ ./
RUN pnpm run build

# Stage 2: Go binaries (webui/dist is embedded via go:embed)
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=webui /src/webui/dist ./webui/dist
ARG VERSION=fork-dev
ENV CGO_ENABLED=0
RUN go build -ldflags "-s -w -X main.version=${VERSION}" -o /out/backrest ./cmd/backrest \
 && go build -ldflags "-s -w" -o /out/docker-entrypoint ./cmd/docker-entrypoint

# Stage 3: runtime
FROM alpine:latest
LABEL org.opencontainers.image.source="https://github.com/Rockyj0e/backrest-rj"
RUN apk --no-cache add tini ca-certificates curl bash rclone openssh tzdata docker-cli && \
    rclone selfupdate --stable
RUN mkdir -p /tmp
COPY --from=build /out/backrest /backrest
COPY --from=build /out/docker-entrypoint /docker-entrypoint

# Run the binary to install dependencies (restic)
RUN /backrest --install-deps-only
RUN mkdir -p /bin && mv /root/.local/share/backrest/restic /bin/restic

ENTRYPOINT ["/sbin/tini", "--", "/docker-entrypoint"]
CMD ["/backrest"]
